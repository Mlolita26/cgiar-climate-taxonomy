      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CCC_10",
      "prefLabel": "Emissions leakage",
      "altLabel": ["indirect land-use change"],
      "definition": "Displacement of emissions to outside a project or policy boundary, offsetting some or all of the reductions achieved within it; includes indirect land-use change.",
      "source": "IPCC",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "adaptationTag": "n/a",
