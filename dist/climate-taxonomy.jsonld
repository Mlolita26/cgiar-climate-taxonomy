    {
      "id": "ct:CRK_124",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_124",
      "prefLabel": "Pluvial flood",
      "altLabel": ["surface-water flood", "waterlogging"],
      "definition": "Flood characterised by surface-water accumulation and waterlogging caused by rainfall exceeding the infiltration and drainage capacity of the land, independent of overflow from a watercourse.",
      "source": "IPCC AR6 WGI Ch.11 (pluvial flooding); AGROVOC: waterlogging (c_8333)",
