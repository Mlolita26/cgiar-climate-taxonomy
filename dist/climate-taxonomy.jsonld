    },
    {
      "id": "ct:CRK_130_1",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_130_1",
      "prefLabel": "Glacier change",
      "altLabel": ["glacier retreat", "glacier loss"],
      "definition": "Hydrological hazard characterised by changes in the mass, extent, and behaviour of glaciers, including retreat and loss of ice, that alter the timing and volume of meltwater supply to downstream water resources.",
      "source": "IPCC SROCC Ch.2: Glaciers",
      "broader": "ct:CRK_121",
      "adaptationTag": "Adaptation-specific",
