    {
      "id": "ct:CRK_121",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_121",
      "prefLabel": "Hydrological hazard",
      "altLabel": ["water-related hazard"],
      "definition": "Abiotic hazard relating to the occurrence, movement, and distribution of water at and below the land surface, comprising events such as floods and changes in water bodies that can harm agricultural and ecological systems.",
      "source": "IPCC AR6 WGII Ch.3; IPCC SROCC",
      "broader": "ct:CRK_161",
      "narrower": ["ct:CRK_122", "ct:CRK_129", "ct:CRK_130_1", "ct:CRK_130_2", "ct:CRK_169"],
