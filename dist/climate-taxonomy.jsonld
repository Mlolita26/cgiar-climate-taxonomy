    },
    {
      "id": "ct:CRK_169",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_169",
      "prefLabel": "Water scarcity",
      "altLabel": ["water-scarce", "water shortage"],
      "definition": "Hydrological hazard in which the demand for freshwater exceeds the available supply within a given geographic area and time period, intensifying as demand grows or as the quantity or quality of water resources declines.",
      "source": "FAO / UN-Water (water scarcity); IPCC AR6 WGII Ch.4",
      "broader": "ct:CRK_121",
