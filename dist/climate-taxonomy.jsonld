    {
      "id": "ct:CRK_164",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_164",
      "prefLabel": "Climate vulnerability",
      "altLabel": ["climate-vulnerable", "vulnerable to climate", "vulnerable to climate risks", "vulnerability to climate change"],
      "definition": "Climate risk component comprising the propensity of a system, community, or household to be adversely affected by climate variability and change, including sensitivity to harm and limited capacity to cope and adapt.",
      "source": "IPCC AR6 WGII Glossary (Vulnerability)",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
