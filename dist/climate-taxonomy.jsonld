      "notation": "OTC_004",
      "prefLabel": "Yield",
      "definition": "Outcome construct denoting the quantity of crop, livestock, or fishery product obtained per unit of land, animal, or effort, treated neutrally as the result whose level may be maintained, raised, or reduced under climate stress (direction of change is a separate facet).",
      "source": "FAO (agricultural productivity / yield)",
      "seeAlso": ["https://www.cgiar.org/innovations/climate-smart-maize"],
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
