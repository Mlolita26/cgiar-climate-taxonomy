      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CCC_09",
      "prefLabel": "Additionality",
      "definition": "Property of a mitigation activity whereby the emission reductions or removals it produces would not have occurred under the baseline scenario, and are therefore genuinely attributable to it.",
      "source": "Verra; AgLEDx",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
