      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_10",
      "prefLabel": "Climate stressor",
      "altLabel": ["slow-onset stressor", "chronic climate stress", "climate stress", "under climate stress"],
      "definition": "Climate hazard with a chronic temporal profile, taking the form of a slow-onset or progressive pressure or trend, such as warming, shifting rainfall seasonality, or salinization, that gradually erodes a system, as distinct from an acute shock.",
      "source": "IPCC AR6 WGII Glossary (Slow onset events); resilience literature",
      "broader": "ct:CRK_100",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
