      "notation": "CRK_113",
      "prefLabel": "Storm",
      "altLabel": ["windstorm"],
      "definition": "Atmospheric hazard characterised by a disturbance of the atmosphere marked by strong winds and often precipitation, thunder, or lightning, with the potential to damage crops, infrastructure, and livelihoods.",
