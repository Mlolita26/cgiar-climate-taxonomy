      "notation": "CCC_11",
      "prefLabel": "Non-permanence",
      "altLabel": ["reversibility"],
      "definition": "Risk that carbon stored by a sequestration activity is subsequently released, reversing some or all of the mitigation benefit.",
      "source": "AgLEDx",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
