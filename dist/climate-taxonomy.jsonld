    {
      "id": "ct:CRK_168",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_168",
      "prefLabel": "Health risk",
      "definition": "Potential for adverse health consequences - disease, injury, malnutrition or death - in human populations, treated as climate-related when attributable to climate hazards or climate-sensitive transmission pathways.",
      "source": "WHO (environmental health risks); IPCC AR6 WGII Ch.7",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "scopeNote": "Counts as adaptation when: Climate risk counts as adaptation when the text attributes it to climate change, climate variability, or a named climate hazard (for example climate-induced, climate-driven, exacerbated by warming, or due to changing rainfall), OR when it is the stated target of an adaptation-specific intervention, climate service, or early-warning action; NOT adaptation when it is described as a routine pest, sanitary, food-safety, land-management, or general social or economic problem with no climate framing.",
      "adaptationTag": "Adaptation-conditional",
      "mitigationTag": "n/a",
      "pathwayStage": "Rationale",
      "climateScope": "Adaptation",
