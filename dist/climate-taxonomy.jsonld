      "climateScope": "Adaptation",
      "isHazard": true,
      "provenance": ["Domain expert"],
      "historyNote": "Provenance note in the master file: Andreea"
    },
    {
      "id": "ct:CRK_166",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_166",
      "prefLabel": "Climate security",
      "altLabel": ["climate-security nexus", "climate and security", "climate-related security risk"],
      "definition": "Dimension of climate risk describing the ways in which climate variability and change interact with social, economic, and political conditions to affect human security, including risks to livelihoods, to food and water access, to mobility, and to peace and stability.",
      "source": "IPCC AR6 WGII Ch.7",
