    },
    {
      "id": "ct:CRK_144",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_144",
      "prefLabel": "Soil hazard",
      "altLabel": ["edaphic hazard"],
      "definition": "Abiotic hazard relating to the soil and land system, comprising processes such as erosion, salinization, and degradation that are driven or accelerated by climate and that diminish the productive capacity of land.",
      "source": "IPCC SRCCL",
      "broader": "ct:CRK_161",
      "narrower": ["ct:CRK_145", "ct:CRK_146", "ct:CRK_147", "ct:CRK_148", "ct:CRK_149", "ct:CRK_150"],
      "scopeNote": "Counts as adaptation when: Climate risk counts as adaptation when the text attributes it to climate change, climate variability, or a named climate hazard (for example climate-induced, climate-driven, exacerbated by warming, or due to changing rainfall), OR when it is the stated target of an adaptation-specific intervention, climate service, or early-warning action; NOT adaptation when it is described as a routine pest, sanitary, food-safety, land-management, or general social or economic problem with no climate framing.",
      "adaptationTag": "Adaptation-conditional",
      "mitigationTag": "n/a",
      "pathwayStage": "Rationale",
      "climateScope": "Adaptation",
      "isHazard": true,
      "provenance": ["Domain expert"],
      "historyNote": "Provenance note in the master file: Todd"
    },
    {
      "id": "ct:CRK_145",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_145",
      "prefLabel": "Soil erosion",
      "altLabel": ["soil loss"],
      "definition": "Soil hazard characterised by the detachment and removal of soil particles by water or wind, accelerated by extreme rainfall, runoff, and loss of vegetation cover, reducing soil depth and fertility.",
      "source": "AGROVOC: soil erosion; IPCC SRCCL",
      "broader": "ct:CRK_144",
      "scopeNote": "Counts as adaptation when: Climate risk counts as adaptation when the text attributes it to climate change, climate variability, or a named climate hazard (for example climate-induced, climate-driven, exacerbated by warming, or due to changing rainfall), OR when it is the stated target of an adaptation-specific intervention, climate service, or early-warning action; NOT adaptation when it is described as a routine pest, sanitary, food-safety, land-management, or general social or economic problem with no climate framing.",
      "adaptationTag": "Adaptation-conditional",
      "mitigationTag": "n/a",
      "pathwayStage": "Rationale",
      "climateScope": "Adaptation",
      "isHazard": true,
      "provenance": ["Domain expert", "Lexicon consensus"],
      "historyNote": "Provenance note in the master file: Todd+Lexicon"
    },
    {
      "id": "ct:CRK_146",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_146",
      "prefLabel": "Soil salinization",
      "altLabel": ["soil salinity", "salinisation", "salinity"],
      "definition": "Soil hazard characterised by the accumulation of soluble salts in the soil profile, driven by factors such as evaporation, poor irrigation, and saline-water intrusion, which impairs plant growth and soil productivity.",
      "source": "AGROVOC: soil salinization (c_35321); IPCC SRCCL",
      "broader": "ct:CRK_144",
