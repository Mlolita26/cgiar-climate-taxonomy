      "notation": "INT_269",
      "prefLabel": "Climate-smart agriculture",
      "altLabel": ["CSA", "climate-smart practice", "climate-smart farming", "climate-smart livestock", "nutri-smart agriculture"],
      "definition": "Intervention that seeks to sustainably increase productivity and incomes, build resilience and adaptive capacity to climate change, and reduce or remove greenhouse-gas emissions where possible.",
