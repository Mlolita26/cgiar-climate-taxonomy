      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_131",
      "prefLabel": "Glacial lake outburst flood",
      "altLabel": ["GLOF"],
      "definition": "Flood characterised by the sudden release of water impounded by a glacial lake, often following dam failure of moraine or ice, producing a destructive downstream flood.",
      "source": "IPCC SROCC Ch.2: Glacial lake outburst flood",
      "broader": "ct:CRK_122",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
