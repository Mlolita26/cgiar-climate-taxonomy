      "notation": "CRK_130_2",
      "prefLabel": "Snowpack change",
      "altLabel": ["snow cover change", "snowmelt change"],
      "definition": "Hydrological hazard characterised by changes in the accumulation, extent, and melt timing of seasonal snow, altering the volume and seasonality of water supply from snowmelt to downstream systems.",
      "source": "IPCC SROCC Ch.2: Snow cover",
