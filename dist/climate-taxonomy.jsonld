    },
    {
      "id": "ct:CCC_01",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CCC_01",
      "prefLabel": "Adaptation limit",
      "altLabel": ["limits to adaptation"],
      "definition": "Cross-cutting concept denoting the point at which the objectives of an actor, or the needs of a system, cannot be secured from intolerable risks through adaptive action.",
      "source": "IPCC AR6 WGII Glossary: Limits to adaptation",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "narrower": ["ct:CCC_02", "ct:CCC_03"],
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
      "pathwayStage": "Cross-cutting",
      "climateScope": "Adaptation",
      "isHazard": false,
      "provenance": ["Domain expert"],
      "historyNote": "Provenance note in the master file: New (Andreea)"
    },
    {
      "id": "ct:CCC_02",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CCC_02",
      "prefLabel": "Soft limit",
      "altLabel": ["soft adaptation limit"],
      "definition": "Adaptation limit at which options exist in principle but are not currently available to avoid intolerable risks through adaptive action.",
      "source": "IPCC AR6 WGII Glossary: Soft adaptation limit",
      "broader": "ct:CCC_01",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
