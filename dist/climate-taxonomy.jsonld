    {
      "id": "ct:CRK_116",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_116",
      "prefLabel": "Rainfall variability",
      "altLabel": ["precipitation variability"],
      "definition": "Atmospheric hazard characterised by deviations in the timing, frequency, intensity, or spatial distribution of precipitation from expected long-term patterns, disrupting crop calendars and water availability.",
      "source": "IPCC AR6 WGI Ch.8: Precipitation variability",
      "broader": "ct:CRK_101",
      "narrower": ["ct:CRK_117", "ct:CRK_118", "ct:CRK_119"],
