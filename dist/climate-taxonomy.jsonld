      "historyNote": "Provenance note in the master file: Todd"
    },
    {
      "id": "ct:CRK_129",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_129",
      "prefLabel": "Salinity intrusion",
      "altLabel": ["Saltwater intrusion", "saline intrusion", "seawater intrusion"],
      "definition": "Hydrological hazard characterised by the inland or upward movement of saline water into freshwater aquifers, soils, or surface water, driven by sea-level rise, storm surge, or reduced freshwater flow, degrading water and soils for agriculture.",
      "source": "IPCC SROCC Ch.4: Saltwater intrusion",
      "broader": "ct:CRK_121",
      "adaptationTag": "Adaptation-specific",
