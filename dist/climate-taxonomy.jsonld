    },
    {
      "id": "ct:CRK_122",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_122",
      "prefLabel": "Flood",
      "altLabel": ["inundation", "submergence", "flooding", "Stagnant flooding"],
      "definition": "Hydrological hazard characterised by the overflowing of the normal confines of a stream or other water body, or the accumulation of water over areas not normally submerged. Sub-types include fluvial, pluvial, flash, coastal, and glacial lake outburst floods.",
      "source": "IPCC AR6 WGII Glossary: Flood",
      "seeAlso": ["https://www.cgiar.org/news-events/news/a-quarter-century-since-the-sub1a-gene-new-flood-tolerant-rice-and-feeding-millions"],
      "broader": "ct:CRK_121",
      "narrower": ["ct:CRK_123", "ct:CRK_124", "ct:CRK_125", "ct:CRK_126", "ct:CRK_131"],
      "example": "IRRI Sub1 and next-generation flood-tolerant rice varieties target submergence and stagnant flooding in rice-growing communities.",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
      "pathwayStage": "Rationale",
      "climateScope": "Adaptation",
      "isHazard": true,
      "provenance": ["Domain expert"],
      "historyNote": "Provenance note in the master file: Andreea+Todd"
    },
    {
      "id": "ct:CRK_123",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_123",
      "prefLabel": "Fluvial flood",
      "altLabel": ["river flood", "riverine flood"],
      "definition": "Flood, also termed a river flood, characterised by the overflow of a watercourse onto adjacent floodplains when river discharge exceeds channel capacity.",
      "source": "IPCC AR6 WGII Ch.4; AGROVOC: flooding (c_2980)",
      "broader": "ct:CRK_122",
      "adaptationTag": "Adaptation-specific",
