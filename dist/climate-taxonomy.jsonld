    {
      "id": "ct:CCC_31",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CCC_31",
      "prefLabel": "Gender-responsive adaptation",
      "definition": "Cross-cutting concept denoting an approach that accounts for and seeks to redress gender-differentiated vulnerabilities, needs, and capacities, promoting the leadership of and equitable benefit to women and marginalised groups in adaptation action.",
      "source": "UNFCCC Lima work programme on gender; GCF Gender Policy",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "adaptationTag": "Adaptation-specific",
