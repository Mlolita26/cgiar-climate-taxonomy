      "mitigationTag": "n/a",
      "pathwayStage": "Rationale",
      "climateScope": "Adaptation",
      "isHazard": true,
      "provenance": ["Domain expert", "Lexicon consensus"],
      "historyNote": "Provenance note in the master file: Andreea+Todd+Lexicon"
    },
