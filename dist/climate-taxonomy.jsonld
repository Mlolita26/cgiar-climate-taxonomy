    },
    {
      "id": "ct:CRK_165",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_165",
      "prefLabel": "Climate sensitivity",
      "altLabel": ["climate-sensitive", "sensitive to climate", "sensitivity to climate", "sensitivity to climate change", "fragility"],
      "definition": "Climate vulnerability component, comprising the degree to which a system, species, or activity is affected, beneficially or adversely, by a given change in climate conditions or by a climate hazard. Named in full to avoid collision with the physical-science term climate sensitivity, which denotes the warming response to a doubling of atmospheric carbon dioxide.",
      "source": "IPCC AR6 WGII Glossary (Sensitivity)",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
      "pathwayStage": "Rationale",
      "climateScope": "Adaptation",
      "isHazard": true,
      "provenance": ["Domain expert", "Lexicon consensus"],
      "historyNote": "Provenance note in the master file: Andreea+Lexicon"
    },
    {
      "id": "ct:CRK_11",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_11",
      "prefLabel": "Tipping point",
      "altLabel": ["critical threshold"],
      "definition": "Critical threshold beyond which a system reorganises, often abruptly and/or irreversibly, in response to a relatively small additional change in conditions such as climate forcing.",
      "source": "IPCC AR6 WGI Glossary: Tipping point",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
      "pathwayStage": "Cross-cutting",
