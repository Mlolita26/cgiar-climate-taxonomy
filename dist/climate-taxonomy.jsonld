      "notation": "CCC_03",
      "prefLabel": "Hard limit",
      "altLabel": ["hard adaptation limit"],
      "definition": "Adaptation limit at which no adaptive actions are possible to avoid intolerable risks.",
      "source": "IPCC AR6 WGII Glossary: Hard adaptation limit",
      "broader": "ct:CCC_01",
