      "notation": "CCC_05",
      "prefLabel": "Adaptation deficit",
      "altLabel": ["adaptation gap"],
      "definition": "Cross-cutting concept denoting the gap between the current state of a system and a state that minimises adverse impacts from existing climate conditions and variability.",
      "source": "IPCC AR6 WGII Glossary: Adaptation deficit",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
