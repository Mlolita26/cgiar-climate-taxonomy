    },
    {
      "id": "ct:CRK_126",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_126",
      "prefLabel": "Flash flood",
      "altLabel": ["flash flooding"],
      "definition": "Flood characterised by a rapid onset and short duration, generated by intense rainfall over a small or steep catchment, leaving little warning time and causing sudden, destructive inundation.",
      "source": "AGROVOC: flash floods; IPCC AR6 WGI Ch.11",
      "broader": "ct:CRK_122",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
