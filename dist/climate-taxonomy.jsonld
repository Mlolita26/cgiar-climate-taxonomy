    {
      "id": "ct:CRK_125",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_125",
      "prefLabel": "Coastal flood",
      "altLabel": ["coastal inundation"],
      "definition": "Flood characterised by the inundation of low-lying coastal land by seawater, driven by storm surge, high tides, waves, or sea-level rise.",
      "source": "IPCC AR6 WGII Ch.3; IPCC SROCC Ch.4",
      "broader": "ct:CRK_122",
      "adaptationTag": "Adaptation-specific",
