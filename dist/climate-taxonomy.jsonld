      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "INT_273",
      "prefLabel": "Locally-led adaptation",
      "altLabel": ["LLA", "Community-led adaptation", "Locally led climate adaptation"],
      "definition": "Intervention in which local communities and institutions hold agency and decision-making power over how adaptation is defined, prioritised, designed, implemented, monitored, and evaluated, with finance and capacity devolved to the lowest appropriate level.",
      "source": "IIED/WRI/GCA Principles for Locally Led Adaptation (2021)",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
