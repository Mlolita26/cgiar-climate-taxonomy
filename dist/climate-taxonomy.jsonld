      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_09",
      "prefLabel": "Climate shock",
      "altLabel": ["climate event", "extreme climate event", "acute shock", "Climate-related shock", "Climate extreme", "extreme weather event"],
      "definition": "Climate hazard with an acute temporal profile, marked by sudden, severe onset, such as a flood, storm, or rapid drought onset, that causes rapid harm, as distinct from a slow-onset stressor.",
      "source": "IPCC AR6 WGII Glossary (Extreme weather event); resilience literature",
      "broader": "ct:CRK_100",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
