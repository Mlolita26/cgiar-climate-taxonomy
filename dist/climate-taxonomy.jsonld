    {
      "id": "ct:CRK_102",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_102",
      "prefLabel": "Drought",
      "altLabel": ["dry spell", "water deficit", "aridity", "water stress"],
      "definition": "Atmospheric hazard characterised by an exceptional period of water shortage for existing ecosystems and the human population, due to low precipitation, high temperature, and/or wind. Sub-types include meteorological, agricultural and ecological, and hydrological drought.",
      "source": "IPCC AR6 WGII Glossary: Drought",
      "seeAlso": ["https://www.cimmyt.org/projects/drought-tolerant-maize-for-africa-dtma/"],
      "broader": "ct:CRK_101",
      "narrower": ["ct:CRK_103", "ct:CRK_104", "ct:CRK_105"],
      "example": "CIMMYT/IITA DTMA and STMA developed drought-tolerant maize varieties for farmers in drought-prone environments in sub-Saharan Africa.",
