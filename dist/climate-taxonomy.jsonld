    },
    {
      "id": "ct:CRK_117",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_117",
      "prefLabel": "Erratic within-season rainfall",
      "altLabel": ["Erratic rainfall", "intra-seasonal variability", "rainfall uncertainty", "irregular precipitation"],
      "definition": "Form of rainfall variability characterised by unpredictable within-season timing, frequency, intensity, or spatial distribution of precipitation, which disrupts crop calendars and farm decisions; distinct from a lasting change in season timing and from sustained shortage or excess.",
      "source": "IPCC AR6 WGI Ch.8: Precipitation variability",
      "seeAlso": ["https://www.cgiar.org/research/publication/participatory-integrated-climate-services-agriculture-picsa-climate-services-farmers-latin-america-caribbean/"],
      "broader": "ct:CRK_116",
      "example": "PICSA integrates climate information with participatory decision tools to support farm planning under erratic rainfall across Africa and Latin America.",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
      "pathwayStage": "Rationale",
      "climateScope": "Adaptation",
      "isHazard": true,
      "provenance": ["Domain expert"],
      "historyNote": "Provenance note in the master file: Andreea+Todd"
    },
    {
      "id": "ct:CRK_118",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_118",
      "prefLabel": "Shifted rainfall seasonality",
      "altLabel": ["delayed onset", "shortened season", "phenological shift"],
      "definition": "Form of rainfall variability characterised by a lasting change in the onset, cessation, or duration of rainy seasons across years, making established crop calendars and livelihood practices less reliable; typically a slow-onset, climate-change-driven stressor distinct from within-season unpredictability.",
      "source": "IPCC AR6 WGI Ch.8: Changes in monsoon and rainy-season timing",
      "seeAlso": ["https://hdl.handle.net/10568/89122"],
      "broader": "ct:CRK_116",
      "example": "CGIAR climate services in Rwanda used seasonal forecasts and historical climate information to support decision-making under shifting rainfall seasons.",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
      "pathwayStage": "Rationale",
      "climateScope": "Adaptation",
      "isHazard": true,
      "provenance": ["Domain expert"],
      "historyNote": "Provenance note in the master file: Andreea+Todd"
    },
    {
      "id": "ct:CRK_119",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_119",
      "prefLabel": "Rainfall intensity change",
      "altLabel": ["extreme precipitation"],
      "definition": "Form of rainfall variability characterised by a change in the amount of precipitation falling per unit time, including increases in heavy and extreme precipitation that raise the risk of erosion, runoff, and flooding.",
      "source": "IPCC AR6 WGI Ch.11: Extreme precipitation",
      "broader": "ct:CRK_116",
      "adaptationTag": "Adaptation-specific",
