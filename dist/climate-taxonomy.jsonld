      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CRK_120",
      "prefLabel": "Dust storm",
      "altLabel": ["sandstorm", "aeolian dust event"],
      "definition": "Storm characterised by strong winds lifting and transporting large quantities of dust or sand, which can damage crops, bury fields, reduce visibility, and degrade air quality and soils.",
      "source": "IPCC AR6 WGI Ch.6: Dust",
      "broader": "ct:CRK_113",
