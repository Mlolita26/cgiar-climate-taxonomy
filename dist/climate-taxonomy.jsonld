    },
    {
      "id": "ct:CCC_35",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CCC_35",
      "prefLabel": "Autonomous adaptation",
      "altLabel": ["spontaneous adaptation"],
      "definition": "Cross-cutting concept denoting an approach that occurs in response to experienced climate and its effects, without explicit or conscious planning focused on addressing climate change.",
      "source": "IPCC AR6 WGII Glossary: Autonomous adaptation",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "adaptationTag": "Adaptation-specific",
      "mitigationTag": "n/a",
      "pathwayStage": "Cross-cutting",
