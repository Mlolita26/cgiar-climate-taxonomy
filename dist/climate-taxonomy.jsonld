    },
    {
      "id": "ct:CCC_28",
      "type": "skos:Concept",
      "inScheme": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "notation": "CCC_28",
      "prefLabel": "Food sovereignty",
      "altLabel": ["autonomy", "food self-determination"],
      "definition": "Cross-cutting concept asserting the right of peoples to define their own food and agriculture systems and to access healthy, culturally appropriate food produced through ecologically sound and sustainable methods.",
      "source": "Declaration of Nyeleni (2007); FAO",
      "topConceptOf": "https://mlolita26.github.io/cgiar-climate-taxonomy/scheme",
      "scopeNote": "Counts as adaptation when: Cross-cutting concept applies to a qualifying intervention, outcome, or impact; NOT adaptation when applied generically with nothing qualifying to attach to.",
      "adaptationTag": "Adaptation-conditional",
      "mitigationTag": "n/a",
      "pathwayStage": "Cross-cutting",
      "climateScope": "Adaptation",
      "isHazard": false,
